  "configById": {
    "Plot!syslens-cpu": {
      "foxglovePanelTitle": "系统 CPU 利用率",
      "paths": [
        {
          "value": "/syslens/system.cpu.usage_percent",
          "enabled": true,
          "timestampMethod": "receiveTime",
          "showLine": true,
          "lineSize": 1.5,
          "label": "总 CPU",
          "id": "cpu-0",
          "color": "#249EFF"
        }
      ],
      "xAxisVal": "timestamp",
      "timeWindowMode": "sliding",
      "followingViewWidth": 60,
      "playbackBarPosition": "right",
      "isSynced": true,
      "showLegend": false,
      "showPlotValuesInLegend": true,
      "legendDisplay": "left",
      "sidebarDimension": 220,
      "showXAxisLabels": true,
      "showYAxisLabels": true,
      "showYAxisGridLines": true,
      "yAxisLabel": "%",
      "minYValue": 0,
      "maxYValue": 100
    },
